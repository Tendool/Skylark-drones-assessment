# Copy to .env (or set as Streamlit secrets / shell exports). Nothing here is
# a real credential.

# --- monday.com ---
# mock  = run entirely on fixtures/ (no monday.com account needed)
# live  = read from a real monday.com account via the GraphQL API
MONDAY_MODE=mock
MONDAY_API_TOKEN=
MONDAY_WORK_ORDERS_BOARD_ID=
MONDAY_DEALS_BOARD_ID=

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=   # only if you finish src/agent/llm_adapter.py's OpenAIAdapter

# --- Backend (FastAPI) ---
# Comma-separated allowed origins for the frontend, when hosted separately.
CORS_ALLOW_ORIGINS=*
