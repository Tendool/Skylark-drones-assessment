# Copy to .env (or set as host/deployment secrets). Nothing here is a real
# credential.

# --- monday.com ---
# mock = run entirely on fixtures/ (no monday.com account needed)
# live = real account, via monday.com's own hosted MCP server (mcp.monday.com)
# api  = real account, via a direct read-only GraphQL client (the alternative
#        built before switching the default to MCP -- see DECISION_LOG.md)
MONDAY_MODE=mock
MONDAY_API_TOKEN=
MONDAY_WORK_ORDERS_BOARD_ID=
MONDAY_DEALS_BOARD_ID=
# MONDAY_MCP_URL=https://mcp.monday.com/mcp   # only override for testing

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=   # only if you finish src/agent/llm_adapter.py's OpenAIAdapter

# --- Backend (FastAPI) ---
# Comma-separated allowed origins for the frontend, when hosted separately.
CORS_ALLOW_ORIGINS=*
